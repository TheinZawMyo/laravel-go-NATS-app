WORKER_INSTANCE_ID=worker-local
WORKER_ADDR=:8082
WORKER_POLL_SECONDS=2

# Outbox dispatcher: publishes committed realtime events to NATS.
WORKER_OUTBOX_POLL_MS=250
WORKER_OUTBOX_BATCH_SIZE=100
WORKER_OUTBOX_MAX_ATTEMPTS=10
EVENT_SUBJECT_PREFIX=chat.events.

DATABASE_URL=postgres://postgres@127.0.0.1:5432/chat_app?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
NATS_URL=nats://127.0.0.1:4222
