WORKER_INSTANCE_ID=worker-local
WORKER_ADDR=:8082
WORKER_POLL_SECONDS=2

# Outbox dispatcher: publishes committed realtime events to NATS.
WORKER_OUTBOX_POLL_MS=250
WORKER_OUTBOX_BATCH_SIZE=100
WORKER_OUTBOX_MAX_ATTEMPTS=10
EVENT_SUBJECT_PREFIX=chat.events.

# Durable broker. JetStream stores every outbox event so a restarted or late
# gateway can still consume it. Disable only for local experiments without -js.
WORKER_JETSTREAM_ENABLED=true
WORKER_JETSTREAM_STREAM=CHAT_EVENTS
WORKER_JETSTREAM_MAX_AGE=24h
WORKER_JETSTREAM_REPLICAS=1

# How often outbox depth and oldest event age are sampled for /metrics.
WORKER_BACKLOG_INTERVAL=15s


DATABASE_URL=postgres://postgres@127.0.0.1:5432/chat_app?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
NATS_URL=nats://127.0.0.1:4222
