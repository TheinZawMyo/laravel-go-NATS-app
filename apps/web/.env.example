APP_NAME="Chat App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Gateway origin (the frontend adds the /ws path).
GATEWAY_URL=ws://localhost:8081
# Must match GATEWAY_TOKEN_SECRET in apps/gateway.
GATEWAY_TOKEN_SECRET=gateway-dev-secret-change-me
# Lifetime of the short lived websocket credential, in seconds.
GATEWAY_TOKEN_TTL=300

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chat_app
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when serving over HTTPS. Defaults to true when APP_ENV=production.
SESSION_SECURE_COOKIE=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Attachment storage: "media" (local, default) or "s3" (MinIO/S3).
MEDIA_DISK=media
MEDIA_DISK_ROOT=
MEDIA_MAX_BYTES=26214400
MEDIA_UPLOAD_TTL_MINUTES=30
MEDIA_PENDING_RETENTION_HOURS=24
MEDIA_THUMBNAIL_MAX_EDGE=480
# Attachments of deleted messages survive this many days before the daily
# media:purge-attachments command reclaims the bytes.
MEDIA_DELETED_MESSAGE_GRACE_DAYS=7

# Malware scanning (clamd INSTREAM). Bytes are scanned before they are written,
# so an infected upload never reaches the disk. With fail_closed=false an
# unreachable scanner accepts the file as unverified instead of rejecting it.
MEDIA_SCAN_ENABLED=false
MEDIA_SCAN_HOST=127.0.0.1
MEDIA_SCAN_PORT=3310
MEDIA_SCAN_TIMEOUT=5
MEDIA_SCAN_FAIL_CLOSED=false

# Video stills and media duration. Missing binaries only skip those extras.
MEDIA_FFMPEG_ENABLED=true
MEDIA_FFMPEG_BINARY=ffmpeg
MEDIA_FFPROBE_BINARY=ffprobe
MEDIA_FFMPEG_TIMEOUT=20

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# The gateway writes presence leases to its REDIS_URL database using the
# unprefixed "presence:*" keys, so reads must not go through REDIS_DB.
PRESENCE_ENABLED=true
PRESENCE_REDIS_CONNECTION=presence
REDIS_PRESENCE_DB=0
REDIS_PRESENCE_PREFIX=

NATS_URL=nats://127.0.0.1:4222

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Point at MinIO for local media: AWS_ENDPOINT=http://127.0.0.1:9000
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Optional fallback origin; the client appends /ws and renews the token.
VITE_GATEWAY_URL=ws://localhost:8081
# Optional JSON array of RTCPeerConnection ICE servers. Add TURN credentials in
# production to support restrictive NATs and enterprise networks.
# VITE_WEBRTC_ICE_SERVERS='[{"urls":"turn:turn.example.com:3478","username":"...","credential":"..."}]'
